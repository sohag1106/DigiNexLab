# Copy this file to .env and fill in real values. NEVER commit .env to git.
# On Netlify, set these same keys in the site's Environment Variables.

# Neon Postgres connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Resend API key for transactional email (fallback transport)
RESEND_API_KEY=re_xxxxxxxx

# The from email used for transactional email when no Zoho mailbox is set.
FROM_EMAIL=no-reply@brightskyit.com

# ---- Zoho Mail mailbox (full inbox: receive + send as sohag@brightskyit.com) ----
# Enables the portal Mail module. Set up a free Zoho Mail mailbox for your domain,
# then enter the address + an app password (Zoho > Account > App passwords).
MAIL_USER=sohag@brightskyit.com
MAIL_PASS=your-zoho-app-password
IMAP_HOST=imap.zoho.com
SMTP_HOST=smtp.zoho.com

# Secret used to sign session JWTs (use a long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Public site / portal base URL (used in email links)
APP_URL=http://localhost:5173
